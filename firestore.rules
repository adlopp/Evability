rules_version = '2';

// Reglas de seguridad de Firestore para la parte social de Evability (amigos, presencia y toques).
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) { return exists(/databases/$(database)/documents/friends/$(pair(a, b))); }
    function inChat(pairId) { return signedIn() && request.auth.uid in pairId.split('_') && exists(/databases/$(database)/documents/friends/$(pairId)); }
    function otherOf(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
    // hasta 3 invitados, todos amigos de quien crea la sala
    function invitedOk(inv) {
      return inv.size() <= 3
        && (inv.size() < 1 || areFriends(request.auth.uid, inv[0]))
        && (inv.size() < 2 || areFriends(request.auth.uid, inv[1]))
        && (inv.size() < 3 || areFriends(request.auth.uid, inv[2]));
    }

    // grupos: miembro de un grupo, y hasta 9 invitados (todos amigos de quien invita; un grupo tiene como mucho 10 personas)
    function inGroup(gid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members; }
    function groupInvitesOk(inv) {
      return inv is list && inv.size() <= 9
        && (inv.size() < 1 || areFriends(request.auth.uid, inv[0]))
        && (inv.size() < 2 || areFriends(request.auth.uid, inv[1]))
        && (inv.size() < 3 || areFriends(request.auth.uid, inv[2]))
        && (inv.size() < 4 || areFriends(request.auth.uid, inv[3]))
        && (inv.size() < 5 || areFriends(request.auth.uid, inv[4]))
        && (inv.size() < 6 || areFriends(request.auth.uid, inv[5]))
        && (inv.size() < 7 || areFriends(request.auth.uid, inv[6]))
        && (inv.size() < 8 || areFriends(request.auth.uid, inv[7]))
        && (inv.size() < 9 || areFriends(request.auth.uid, inv[8]));
    }

    // nombre de usuario -> uid (el nombre solo se puede reservar una vez)
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('[a-z0-9_]{3,16}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // perfil público: nombre y foto pequeña (JPEG en base64)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'photo'])
        && request.resource.data.username is string
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 30000
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if request.auth.uid == uid;
    }

    // foto en alta resolución (solo se descarga al ampliar un perfil); la miniatura de las listas va en users/{uid}
    match /photos/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 150000;
      allow delete: if request.auth.uid == uid;
    }

    // PDF enviados a un amigo: se trocean en partes de ~600 KB (máx. 10 MB). El receptor los baja y los borra.
    match /shares/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'name', 'size', 'chunks', 'ready', 'at'])
        && request.resource.data.from == request.auth.uid
        && areFriends(request.auth.uid, request.resource.data.to)
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.size is int && request.resource.data.size <= 10485760
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 20
        && request.resource.data.ready == false
        && request.resource.data.at == request.time;
      allow update: if signedIn() && resource.data.from == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready'])
        && request.resource.data.ready == true;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      match /parts/{n} {
        allow create: if signedIn()
          && get(/databases/$(database)/documents/shares/$(id)).data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow read, delete: if signedIn()
          && (get(/databases/$(database)/documents/shares/$(id)).data.from == request.auth.uid
            || get(/databases/$(database)/documents/shares/$(id)).data.to == request.auth.uid);
      }
    }

    // última conexión: solo la ve el propio usuario y sus amigos
    match /presence/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || areFriends(request.auth.uid, uid));
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'studying'])
        && request.resource.data.lastSeen == request.time
        && (!('studying' in request.resource.data) || request.resource.data.studying is bool);
    }

    // solicitudes de amistad: id = origen_destino
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // amistades: id = los dos uid ordenados; solo se crea si la otra persona había enviado una solicitud
    match /friends/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == pair(request.resource.data.members[0], request.resource.data.members[1])
        && exists(/databases/$(database)/documents/requests/$(otherOf(request.resource.data.members) + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // chat entre amigos: chats/{id de los dos uid ordenados}. El documento del chat guarda quién escribió el último y cuándo
    // (para el punto de «mensajes sin leer») y los mensajes van en la subcolección messages.
    match /chats/{pairId} {
      allow read, delete: if inChat(pairId);
      allow create, update: if inChat(pairId)
        && request.resource.data.keys().hasOnly(['lastAt', 'lastFrom'])
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastAt == request.time;

      match /messages/{msgId} {
        allow read, delete: if inChat(pairId);
        // borrar un mensaje propio: se vacía y queda marcado (del) con la hora (delAt) para que el otro lo vea sin releer todo el chat
        allow update: if inChat(pairId) && resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['del', 'text', 'rq', 'delAt'])
          && request.resource.data.del == true && request.resource.data.text == ''
          && request.resource.data.delAt == request.time;
        // Mensaje de texto, de audio (kind = 'audio': solo guarda la duración; el audio va aparte, en audio/{mismo id}) o de foto
        // (kind = 'image': la foto va en ese mismo documento audio/{mismo id}).
        allow create: if inChat(pairId)
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'kind', 'dur', 'mime', 'game', 'mins', 'rid', 'rq', 'rf'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000
          // respuesta a un mensaje: id, extracto y autor del mensaje citado
          && (!('rid' in request.resource.data) || (request.resource.data.rid is string && request.resource.data.rid.size() < 64
              && request.resource.data.rq is string && request.resource.data.rq.size() <= 120
              && request.resource.data.rf is string && request.resource.data.rf.size() < 64))
          && (
            (!('kind' in request.resource.data) && request.resource.data.text.size() > 0)
            || (request.resource.data.kind == 'audio' && request.resource.data.text.size() == 0
                && request.resource.data.dur is int && request.resource.data.dur <= 125000
                && request.resource.data.mime is string && request.resource.data.mime.size() < 40)
            || (request.resource.data.kind == 'image' && request.resource.data.text.size() == 0
                && request.resource.data.mime is string && request.resource.data.mime.size() < 40)
            || (request.resource.data.kind == 'poly' && request.resource.data.text.size() == 0
                && request.resource.data.game is string && request.resource.data.game.size() < 64)
            || (request.resource.data.kind == 'chess' && request.resource.data.text.size() == 0
                && request.resource.data.game is string && request.resource.data.game.size() < 64
                && request.resource.data.mins is int && request.resource.data.mins >= 0 && request.resource.data.mins <= 60)
          );
      }

      // partidas de ajedrez: chats/{pareja}/games/{id del mensaje de invitación}. `moves` = jugadas («e2e4», «e7e8q»);
      // blancas mueven cuando hay un número par de jugadas. wms/bms = milisegundos que le quedan a blancas/negras en `lastAt`.
      match /games/{gid} {
        allow read: if inChat(pairId);
        allow create: if inChat(pairId)
          && request.resource.data.keys().hasOnly(['creator', 'joiner', 'white', 'black', 'status', 'mins', 'moves', 'wms', 'bms', 'lastAt', 'result', 'reason', 'drawOffer'])
          && request.resource.data.creator == request.auth.uid
          && request.resource.data.status == 'waiting'
          && request.resource.data.moves.size() == 0
          && request.resource.data.joiner == '' && request.resource.data.white == '' && request.resource.data.black == ''
          && request.resource.data.mins is int && request.resource.data.mins >= 0 && request.resource.data.mins <= 60
          && request.resource.data.result == '' && request.resource.data.drawOffer == '';
        allow update: if inChat(pairId) && (
          // unirse: el otro amigo; los colores se reparten al azar entre los dos
          (resource.data.status == 'waiting' && resource.data.creator != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'joiner', 'white', 'black', 'wms', 'bms', 'lastAt'])
            && request.resource.data.status == 'playing' && request.resource.data.joiner == request.auth.uid
            && ((request.resource.data.white == resource.data.creator && request.resource.data.black == request.auth.uid)
                || (request.resource.data.white == request.auth.uid && request.resource.data.black == resource.data.creator)))
          // jugada: solo la persona a la que le toca, y exactamente una jugada más
          || (resource.data.status == 'playing'
            && (request.auth.uid == resource.data.white || request.auth.uid == resource.data.black)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moves', 'wms', 'bms', 'lastAt', 'status', 'result', 'reason', 'drawOffer'])
            && request.resource.data.moves.size() == resource.data.moves.size() + 1
            && request.auth.uid == (resource.data.moves.size() % 2 == 0 ? resource.data.white : resource.data.black))
          // rendirse, tablas, tiempo agotado u oferta de tablas: cualquiera de los dos jugadores
          || (resource.data.status == 'playing'
            && (request.auth.uid == resource.data.white || request.auth.uid == resource.data.black)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'reason', 'drawOffer']))
        );
      }

      // el contenido de los audios (base64, unos 3 KB por segundo) y de las fotos: solo se descarga al reproducir / abrir
      match /audio/{audioId} {
        allow read, delete: if inChat(pairId);
        allow create: if inChat(pairId)
          && request.resource.data.keys().hasOnly(['from', 'data'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      }
    }

    // grupos de amigos: groups/{id}. `members` = quienes ya están dentro (el primero es quien lo crea y manda), `invited` = invitaciones
    // pendientes (hasta 10 personas entre los dos). Solo se puede invitar a amigos. Cada uno acepta o rechaza su invitación, y las
    // entradas y salidas de las listas se hacen con transformaciones (añadir / quitar un uid) para que dos cambios a la vez no se pisen.
    // El documento también guarda quién escribió el último mensaje y cuándo (punto de «mensajes sin leer»).
    match /groups/{gid} {
      allow read: if signedIn() && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'name', 'desc', 'photo', 'members', 'invited', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 200
        && request.resource.data.photo is string && request.resource.data.photo.size() < 30000
        && !(request.auth.uid in request.resource.data.invited)
        && groupInvitesOk(request.resource.data.invited)
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (
        // quien lo creó cambia el nombre, la descripción o la foto
        (request.auth.uid == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'desc', 'photo'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.desc is string && request.resource.data.desc.size() <= 200
          && request.resource.data.photo is string && request.resource.data.photo.size() < 30000)
        // quien lo creó invita a más amigos
        || (request.auth.uid == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
          && request.resource.data.invited.hasAll(resource.data.invited)
          && groupInvitesOk(request.resource.data.invited)
          && request.resource.data.invited.size() + resource.data.members.size() <= 10)
        // un invitado acepta: pasa de invitados a miembros
        || (request.auth.uid in resource.data.invited && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invited'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && !(request.auth.uid in request.resource.data.invited)
          && request.resource.data.invited.size() == resource.data.invited.size() - 1
          && resource.data.invited.hasAll(request.resource.data.invited))
        // un invitado rechaza
        || (request.auth.uid in resource.data.invited
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
          && !(request.auth.uid in request.resource.data.invited)
          && request.resource.data.invited.size() == resource.data.invited.size() - 1
          && resource.data.invited.hasAll(request.resource.data.invited))
        // un miembro sale (menos quien lo creó, que lo elimina)
        || (request.auth.uid in resource.data.members && request.auth.uid != resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members))
        // quien lo creó echa a un miembro
        || (request.auth.uid == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members))
        // un miembro marca quién escribió el último mensaje y cuándo
        || (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFrom', 'lastAt'])
          && request.resource.data.lastFrom == request.auth.uid
          && request.resource.data.lastAt == request.time)
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      match /messages/{msgId} {
        allow read: if inGroup(gid);
        // borrar un mensaje propio: se vacía y queda marcado (del) con la hora (delAt), como en el chat entre amigos
        allow update: if inGroup(gid) && resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['del', 'text', 'rq', 'delAt'])
          && request.resource.data.del == true && request.resource.data.text == ''
          && request.resource.data.delAt == request.time;
        // texto, audio (kind = 'audio') o foto (kind = 'image'); el contenido de audios y fotos va en groups/{id}/audio/{mismo id}
        allow create: if inGroup(gid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'kind', 'dur', 'mime', 'game', 'mins', 'rid', 'rq', 'rf'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000
          && (!('rid' in request.resource.data) || (request.resource.data.rid is string && request.resource.data.rid.size() < 64
              && request.resource.data.rq is string && request.resource.data.rq.size() <= 120
              && request.resource.data.rf is string && request.resource.data.rf.size() < 64))
          && (
            (!('kind' in request.resource.data) && request.resource.data.text.size() > 0)
            || (request.resource.data.kind == 'audio' && request.resource.data.text.size() == 0
                && request.resource.data.dur is int && request.resource.data.dur <= 125000
                && request.resource.data.mime is string && request.resource.data.mime.size() < 40)
            || (request.resource.data.kind == 'image' && request.resource.data.text.size() == 0
                && request.resource.data.mime is string && request.resource.data.mime.size() < 40)
            || (request.resource.data.kind == 'poly' && request.resource.data.text.size() == 0
                && request.resource.data.game is string && request.resource.data.game.size() < 64)
            || (request.resource.data.kind == 'chess' && request.resource.data.text.size() == 0
                && request.resource.data.game is string && request.resource.data.game.size() < 64
                && request.resource.data.mins is int && request.resource.data.mins >= 0 && request.resource.data.mins <= 60)
          );
      }

      // partidas de ajedrez del grupo: como en el chat entre amigos, pero se une la primera persona del grupo que lo intenta
      // (el estado «waiting» pasa a «playing» una sola vez) y las demás ya no pueden jugar ni mover.
      match /games/{gameId} {
        allow read: if inGroup(gid);
        allow create: if inGroup(gid)
          && request.resource.data.keys().hasOnly(['creator', 'joiner', 'white', 'black', 'status', 'mins', 'moves', 'wms', 'bms', 'lastAt', 'result', 'reason', 'drawOffer'])
          && request.resource.data.creator == request.auth.uid
          && request.resource.data.status == 'waiting'
          && request.resource.data.moves.size() == 0
          && request.resource.data.joiner == '' && request.resource.data.white == '' && request.resource.data.black == ''
          && request.resource.data.mins is int && request.resource.data.mins >= 0 && request.resource.data.mins <= 60
          && request.resource.data.result == '' && request.resource.data.drawOffer == '';
        allow update: if inGroup(gid) && (
          (resource.data.status == 'waiting' && resource.data.creator != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'joiner', 'white', 'black', 'wms', 'bms', 'lastAt'])
            && request.resource.data.status == 'playing' && request.resource.data.joiner == request.auth.uid
            && ((request.resource.data.white == resource.data.creator && request.resource.data.black == request.auth.uid)
                || (request.resource.data.white == request.auth.uid && request.resource.data.black == resource.data.creator)))
          || (resource.data.status == 'playing'
            && (request.auth.uid == resource.data.white || request.auth.uid == resource.data.black)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moves', 'wms', 'bms', 'lastAt', 'status', 'result', 'reason', 'drawOffer'])
            && request.resource.data.moves.size() == resource.data.moves.size() + 1
            && request.auth.uid == (resource.data.moves.size() % 2 == 0 ? resource.data.white : resource.data.black))
          || (resource.data.status == 'playing'
            && (request.auth.uid == resource.data.white || request.auth.uid == resource.data.black)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'reason', 'drawOffer']))
        );
      }

      match /audio/{audioId} {
        allow read: if inGroup(gid);
        allow delete: if inGroup(gid) && resource.data.from == request.auth.uid;
        allow create: if inGroup(gid)
          && request.resource.data.keys().hasOnly(['from', 'data'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
      }
    }

    // foto del grupo en alta resolución (se descarga al ampliarla; la miniatura de las listas va en groups/{id}); solo la sube quien lo creó
    match /groupPhotos/{gid} {
      allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      allow create, update: if signedIn() && get(/databases/$(database)/documents/groups/$(gid)).data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 150000;
      allow delete: if signedIn() && get(/databases/$(database)/documents/groups/$(gid)).data.owner == request.auth.uid;
    }

    // salas del Evapoly (Monopoly) de hasta 4 jugadores: rooms/{id}. `players` = asientos por orden de llegada (el primero es quien
    // la crea), `tok` = ficha de cada uno, `acts` = lista de acciones de la partida (cada jugador añade una; las reglas del juego las
    // aplica y valida cada dispositivo con el mismo motor y la semilla `seed`). Si la sala se crea desde un grupo lleva `group` (id del
    // grupo): cualquier miembro puede verla y entrar hasta que se llene, sin invitación.
    match /rooms/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.host || request.auth.uid in resource.data.invited || request.auth.uid in resource.data.players
          || ('group' in resource.data && inGroup(resource.data.group)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['host', 'invited', 'players', 'tok', 'money', 'goBonus', 'auction', 'pot', 'dblBonus', 'rails', 'ownerFree', 'shop', 'events', 'goals', 'group', 'status', 'seed', 'acts', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.players == [request.auth.uid]
        && (('group' in request.resource.data)
          ? (request.resource.data.group is string && inGroup(request.resource.data.group) && request.resource.data.invited.size() == 0)
          : invitedOk(request.resource.data.invited))
        && request.resource.data.status == 'lobby'
        && request.resource.data.money is int && request.resource.data.money >= 500 && request.resource.data.money <= 2500
        && request.resource.data.goBonus is bool && request.resource.data.auction is bool
        && (!('pot' in request.resource.data) || request.resource.data.pot is bool)
        && (!('dblBonus' in request.resource.data) || request.resource.data.dblBonus is bool)
        && (!('rails' in request.resource.data) || request.resource.data.rails is bool)
        && (!('ownerFree' in request.resource.data) || request.resource.data.ownerFree is bool)
        && (!('shop' in request.resource.data) || request.resource.data.shop is bool)
        && (!('events' in request.resource.data) || request.resource.data.events is bool)
        && (!('goals' in request.resource.data) || request.resource.data.goals is bool)
        && request.resource.data.acts.size() == 0
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (
        // el anfitrión cambia las reglas o invita a más amigos (solo en la sala de espera)
        (request.auth.uid == resource.data.host && resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['money', 'goBonus', 'auction', 'pot', 'dblBonus', 'rails', 'ownerFree', 'shop', 'events', 'goals', 'invited'])
          && request.resource.data.money is int && request.resource.data.money >= 500 && request.resource.data.money <= 2500
          && request.resource.data.goBonus is bool && request.resource.data.auction is bool
          && (!('pot' in request.resource.data) || request.resource.data.pot is bool)
          && (!('dblBonus' in request.resource.data) || request.resource.data.dblBonus is bool)
          && (!('rails' in request.resource.data) || request.resource.data.rails is bool)
          && (!('ownerFree' in request.resource.data) || request.resource.data.ownerFree is bool)
          && (!('shop' in request.resource.data) || request.resource.data.shop is bool)
          && (!('events' in request.resource.data) || request.resource.data.events is bool)
          && (!('goals' in request.resource.data) || request.resource.data.goals is bool)
          && request.resource.data.invited.hasAll(resource.data.invited) && invitedOk(request.resource.data.invited))
        // un invitado entra
        || (resource.data.status == 'lobby'
          && (request.auth.uid in resource.data.invited || ('group' in resource.data && inGroup(resource.data.group)))
          && !(request.auth.uid in resource.data.players)
          && resource.data.players.size() < 4
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'tok'])
          && request.resource.data.players == resource.data.players.concat([request.auth.uid]))
        // un jugador sale (menos el anfitrión)
        || (resource.data.status == 'lobby' && request.auth.uid != resource.data.host && request.auth.uid in resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'tok'])
          && request.resource.data.players.size() == resource.data.players.size() - 1
          && !(request.auth.uid in request.resource.data.players)
          && resource.data.players.hasAll(request.resource.data.players))
        // elegir ficha
        || (resource.data.status == 'lobby' && request.auth.uid in resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tok']))
        // empezar la partida
        || (request.auth.uid == resource.data.host && resource.data.status == 'lobby' && resource.data.players.size() >= 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seed'])
          && request.resource.data.status == 'playing' && request.resource.data.seed is int)
        // jugar: exactamente una acción más
        || (resource.data.status == 'playing' && request.auth.uid in resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acts', 'status'])
          && request.resource.data.acts.size() == resource.data.acts.size() + 1
          && (request.resource.data.status == 'playing' || request.resource.data.status == 'finished'))
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.host;
    }

    // toques (corazones): id = destino_origen; como mucho uno cada 15 minutos por amigo (lo comprueba el servidor)
    match /pokes/{id} {
      // (si el documento todavía no existe, se puede leer: así la lista de amigos puede preguntar por todos a la vez)
      allow read: if signedIn() && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && areFriends(request.auth.uid, request.resource.data.to)
        && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(15, 'm'));
    }
  }
}
